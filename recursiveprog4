#include <stdio.h>
 
int fib(int n) {
    if (n == 0) return 0;
    if (n == 1) return 1;
    return fib(n - 1) + fib(n - 2);
}
 
void series(int i, int n) {      /* prints terms i to n-1 */
    if (i == n)
        return;
    printf("%d ", fib(i));
    series(i + 1, n);
}
 
int main() {
    int n;
    printf("Enter number of terms: ");
    scanf("%d", &n);
    printf("Fibonacci series: ");
    series(0, n);
    printf("\n");
    return 0;
}
